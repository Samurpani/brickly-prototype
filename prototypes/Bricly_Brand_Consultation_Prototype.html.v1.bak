<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bricly Studio — Brand Consultation</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Cormorant+Garamond:wght@500;600&family=Archivo:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0a0a0b; --fg:#f2f0ea; --dim:#8a877e; --faint:#3a3934;
  --accent:#c8c2ff; --accent-deep:#8f85e8; --accent-ink:#0a0a0b;
  --card:#131315; --card2:#18181b; --line:#232326;
  --r:14px; --ease:cubic-bezier(.22,.9,.3,1);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--fg);font-family:'Space Grotesk',sans-serif;font-size:15px;line-height:1.5;overflow-x:hidden;transition:background 1.2s var(--ease)}
::selection{background:var(--accent);color:var(--accent-ink)}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
input[type=text]{font-family:inherit}

/* ── PERSISTENT CHROME ─────────────────────────── */
#rail{position:fixed;top:0;left:0;right:0;height:52px;display:flex;align-items:center;gap:8px;padding:0 88px 0 28px;z-index:60;
  background:linear-gradient(to bottom, rgba(10,10,11,.92), rgba(10,10,11,0));backdrop-filter:blur(6px);pointer-events:none}
#rail .rail-label{font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--faint);margin-right:6px;white-space:nowrap}
.ichip{font-size:11px;color:var(--dim);border:1px solid var(--line);border-radius:999px;padding:4px 12px;white-space:nowrap;
  animation:chipIn .5s var(--ease) both;background:rgba(19,19,21,.8);pointer-events:auto}
.ichip b{color:var(--accent);font-weight:500}
@keyframes chipIn{from{opacity:0;transform:translateY(14px) scale(.85)}to{opacity:1;transform:none}}

#spine{position:fixed;right:26px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:14px;z-index:60}
.snode{width:8px;height:8px;border-radius:50%;border:1.5px solid var(--faint);position:relative;cursor:default;transition:all .4s var(--ease)}
.snode.done{background:var(--accent);border-color:var(--accent);cursor:pointer}
.snode.now{border-color:var(--accent);animation:pulse 1.6s ease-in-out infinite}
.snode .stip{position:absolute;right:18px;top:50%;transform:translateY(-50%);font-size:10px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--dim);white-space:nowrap;opacity:0;transition:opacity .2s;pointer-events:none}
.snode:hover .stip{opacity:1}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(200,194,255,.5)}50%{box-shadow:0 0 0 6px rgba(200,194,255,0)}}

/* ── STREAM ─────────────────────────────────────── */
#stage{max-width:820px;margin:0 auto;padding:96px 40px 180px}
.agent-line{font-size:24px;font-weight:400;line-height:1.35;letter-spacing:-.01em;margin:44px 0 8px;max-width:660px}
.agent-line .w{opacity:0;display:inline;animation:wIn .4s var(--ease) forwards}
@keyframes wIn{from{opacity:0;filter:blur(4px)}to{opacity:1;filter:none}}
.agent-sub{color:var(--dim);font-size:14px;max-width:600px;margin:2px 0 6px}
.user-line{text-align:right;color:var(--dim);font-size:13px;margin:18px 0 4px;animation:fadeUp .4s var(--ease) both}
.user-line span{border-bottom:1px solid var(--faint);padding-bottom:2px}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:26px;margin:18px 0;animation:cardIn .5s var(--ease) both;position:relative}
@keyframes cardIn{from{opacity:0;transform:translateY(22px) scale(.985)}to{opacity:1;transform:none}}
.card .card-tag{font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--accent);margin-bottom:14px}

/* chips */
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 4px}
.chip{border:1px solid var(--line);border-radius:999px;padding:9px 18px;font-size:13px;color:var(--fg);transition:all .18s var(--ease);animation:fadeUp .4s var(--ease) both}
.chip:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-1px)}
.chip.ghost{color:var(--dim);border-style:dashed}
.btn-p{background:var(--accent);color:var(--accent-ink);border-radius:999px;padding:11px 26px;font-size:14px;font-weight:600;transition:all .2s var(--ease);letter-spacing:.01em}
.btn-p:hover{transform:translateY(-1px);filter:brightness(1.08)}
.btn-g{border:1px solid var(--line);border-radius:999px;padding:10px 22px;font-size:13px;color:var(--dim);transition:all .18s}
.btn-g:hover{color:var(--fg);border-color:var(--dim)}
.actions{display:flex;gap:10px;align-items:center;margin-top:20px;flex-wrap:wrap}

/* freeform input row */
.free-row{display:flex;gap:8px;margin-top:12px}
.free-row input{flex:1;background:var(--card2);border:1px solid var(--line);border-radius:10px;padding:11px 14px;color:var(--fg);font-size:14px;outline:none}
.free-row input:focus{border-color:var(--accent)}

/* receipts */
.receipt{background:transparent;border:1px solid var(--line);border-radius:12px;padding:13px 18px;margin:14px 0;display:flex;align-items:center;gap:14px;
  cursor:pointer;transition:border-color .2s;animation:receiptIn .45s var(--ease) both;font-size:13px}
.receipt:hover{border-color:var(--accent)}
.receipt .r-check{width:20px;height:20px;border-radius:50%;background:var(--accent);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex:none}
.receipt .r-label{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--dim);width:96px;flex:none}
.receipt .r-val{color:var(--fg);flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.receipt .r-edit{font-size:11px;color:var(--faint)}
.receipt:hover .r-edit{color:var(--accent)}
@keyframes receiptIn{from{opacity:0;transform:scaleY(.6);transform-origin:top}to{opacity:1;transform:none}}
.receipt.flying{transition:all .55s var(--ease);opacity:.15;transform:translateX(40px) scale(.92)}

/* dossier */
.dossier .d-row{display:flex;gap:16px;padding:10px 0;border-bottom:1px solid var(--line);opacity:0;animation:dRow .5s var(--ease) forwards;align-items:baseline}
.dossier .d-row:last-child{border-bottom:none}
@keyframes dRow{from{opacity:0;transform:translateX(-14px)}to{opacity:1;transform:none}}
.d-key{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--dim);width:130px;flex:none}
.d-val{font-size:15px;flex:1}
.d-val[contenteditable]{outline:none;border-bottom:1px dashed transparent;transition:border-color .2s}
.d-val[contenteditable]:hover{border-bottom-color:var(--faint)}
.d-val[contenteditable]:focus{border-bottom-color:var(--accent)}
.d-edit-hint{font-size:11px;color:var(--faint);margin-top:12px}

/* names */
.ngroup{margin:18px 0 6px}
.ngroup-h{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--dim);margin-bottom:10px}
.nopt{display:flex;align-items:baseline;gap:14px;padding:11px 14px;border-radius:10px;border:1px solid transparent;cursor:pointer;transition:all .16s}
.nopt:hover{background:var(--card2);border-color:var(--line)}
.nopt.sel{border-color:var(--accent);background:var(--card2)}
.nopt .n-name{font-size:17px;font-weight:500;white-space:nowrap}
.nopt .n-why{font-size:12px;color:var(--dim)}
#wordmark-stage{background:var(--card2);border:1px solid var(--line);border-radius:12px;min-height:150px;display:flex;flex-direction:column;align-items:center;justify-content:center;margin:18px 0;padding:24px;overflow:hidden}
#wm-name{font-size:44px;letter-spacing:.02em;transition:all .5s var(--ease);text-align:center}
#wm-name.f-serif{font-family:'Cormorant Garamond',serif;font-weight:600;letter-spacing:.04em}
#wm-name.f-grot{font-family:'Space Grotesk',sans-serif;font-weight:300;letter-spacing:.3em;text-transform:uppercase;font-size:32px}
#wm-name.f-disp{font-family:'Archivo',sans-serif;font-weight:800;letter-spacing:-.02em;text-transform:uppercase}
#wm-by{font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:var(--dim);margin-top:12px;transition:opacity .3s}
.toggle-row{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--dim);margin-top:6px}
.tg{width:38px;height:21px;border-radius:999px;background:var(--faint);position:relative;cursor:pointer;transition:background .2s;flex:none}
.tg::after{content:"";position:absolute;top:2.5px;left:3px;width:16px;height:16px;border-radius:50%;background:var(--fg);transition:transform .2s var(--ease)}
.tg.on{background:var(--accent)}
.tg.on::after{transform:translateX(16px)}

/* personas */
.pgrid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:6px}
.pcard{background:var(--card2);border:1px solid var(--line);border-radius:12px;padding:18px;animation:fadeUp .5s var(--ease) both;position:relative}
.pcard .p-type{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--accent);margin-bottom:6px}
.pcard h4{font-size:16px;font-weight:500;margin-bottom:4px}
.pcard .p-mot{font-size:12px;color:var(--dim);margin-bottom:12px}
.pcard .p-band{font-size:13px;margin-bottom:4px}
.pcard input[type=range]{width:100%;accent-color:var(--accent)}
.pcard .p-pin{font-size:11px;color:var(--accent);border-top:1px solid var(--line);padding-top:10px;margin-top:10px}
.pcard .p-pin.warn{color:#e8a13c}
.pcard .p-x{position:absolute;top:12px;right:14px;color:var(--faint);font-size:14px}
.pcard .p-x:hover{color:var(--fg)}

/* tone */
.slider-row{margin:20px 0}
.slider-row .s-labels{display:flex;justify-content:space-between;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);margin-bottom:8px}
.slider-row input[type=range]{width:100%;accent-color:var(--accent)}
#tone-preview{background:var(--card2);border:1px solid var(--line);border-radius:12px;padding:26px;margin-top:22px;min-height:110px}
#tone-h{font-size:22px;font-weight:500;line-height:1.3;transition:opacity .25s}
#tone-b{font-size:13px;color:var(--dim);margin-top:8px;transition:opacity .25s}

/* interstitial + overlays */
.overlay{position:fixed;inset:0;z-index:100;background:var(--bg);display:flex;align-items:center;justify-content:center;flex-direction:column;animation:fadeIn .4s both}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.shimmer-text{font-size:26px;font-weight:300;letter-spacing:.02em;background:linear-gradient(100deg,var(--dim) 30%,var(--fg) 50%,var(--dim) 70%);
  background-size:220% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:shimmer 1.8s linear infinite}
@keyframes shimmer{from{background-position:200% 0}to{background-position:-20% 0}}
#colorwash{position:fixed;inset:0;z-index:140;pointer-events:none;opacity:0}
#colorwash.go{animation:wash 1.5s var(--ease) both}
@keyframes wash{0%{opacity:0;clip-path:circle(0% at 50% 55%)}35%{opacity:.95}100%{opacity:0;clip-path:circle(150% at 50% 55%)}}

/* direction boards */
#boards-ov{padding:0}
.board-viewport{position:relative;width:100%;height:100%;display:flex;align-items:center;justify-content:center}
.board{width:min(960px,86vw);height:min(640px,84vh);border-radius:20px;overflow:hidden;position:relative;display:grid;
  grid-template-columns:1.35fr 1fr;border:1px solid var(--line);background:var(--card);animation:boardIn .5s var(--ease) both}
@keyframes boardIn{from{opacity:0;transform:scale(.96)}to{opacity:1;transform:none}}
.b-hero{position:relative;overflow:hidden}
.b-side{padding:30px 30px 24px;display:flex;flex-direction:column;gap:14px;overflow:auto}
.b-kicker{font-size:10px;letter-spacing:.24em;text-transform:uppercase;opacity:.75}
.b-title{font-size:30px;font-weight:500;letter-spacing:-.01em;line-height:1.1}
.b-kw{font-size:12px;opacity:.7}
.b-pal{display:flex;gap:6px}
.b-pal .swatch{flex:1;height:44px;border-radius:8px;position:relative}
.b-pal .swatch span{position:absolute;bottom:4px;left:6px;font-size:8.5px;letter-spacing:.04em;opacity:.85;font-family:monospace}
.b-type-spec{border:1px solid rgba(255,255,255,.14);border-radius:10px;padding:12px 14px}
.b-type-spec .t-disp{font-size:20px;line-height:1.15}
.b-type-spec .t-body{font-size:11px;opacity:.7;margin-top:4px}
.b-mats{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.b-mats .mat{height:44px;border-radius:8px}
.b-pos{font-size:12.5px;opacity:.85;font-style:italic;line-height:1.45}
.b-why{font-size:12.5px;line-height:1.5;border-left:2px solid currentColor;padding-left:12px;opacity:.95}
.b-why b{font-weight:600}
.b-pick{margin-top:auto}
.board-nav{position:absolute;top:50%;transform:translateY(-50%);width:46px;height:46px;border-radius:50%;border:1px solid var(--line);
  background:rgba(10,10,11,.7);color:var(--fg);font-size:18px;z-index:5;transition:all .2s;backdrop-filter:blur(4px)}
.board-nav:hover{border-color:var(--accent);color:var(--accent)}
#bnav-l{left:calc(50% - min(480px,43vw) - 66px)}
#bnav-r{right:calc(50% - min(480px,43vw) - 66px)}
.board-dots{position:absolute;bottom:26px;left:50%;transform:translateX(-50%);display:flex;gap:8px;align-items:center}
.bdot{width:7px;height:7px;border-radius:50%;background:var(--faint);transition:all .2s}
.bdot.on{background:var(--fg);transform:scale(1.3)}
.board-footer{position:absolute;top:24px;left:50%;transform:translateX(-50%);display:flex;gap:14px;align-items:center;z-index:5}
.board-footer .bf-label{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--dim)}

/* this-or-that */
.tot{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
.tot-side{border-radius:14px;overflow:hidden;border:1px solid var(--line);cursor:pointer;transition:all .25s var(--ease);position:relative;height:280px}
.tot-side:hover{transform:scale(1.025);border-color:var(--accent);z-index:2}
.tot-side .tot-art{position:absolute;inset:0}
.tot-side .tot-cap{position:absolute;bottom:0;left:0;right:0;padding:14px 16px;font-size:13px;font-weight:500;
  background:linear-gradient(to top,rgba(0,0,0,.72),transparent);color:#fff}
.tot-side .tot-cap small{display:block;font-weight:400;font-size:11px;opacity:.75;margin-top:2px}
#bspine{position:fixed;left:26px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:12px;z-index:60}
.bs-node{display:flex;align-items:center;gap:9px;opacity:0;transform:translateX(-16px);transition:all .5s var(--ease)}
.bs-node.on{opacity:1;transform:none}
.bs-node .bs-dot{width:9px;height:9px;border-radius:50%;background:var(--accent)}
.bs-node .bs-lab{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--dim)}
@media (max-width:1460px){.bs-node .bs-lab{display:none}}

/* renders */
.rgal{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:6px}
.rshot{border-radius:12px;overflow:hidden;border:1px solid var(--line);opacity:0;transform:translateY(16px);transition:all .8s var(--ease);position:relative}
.rshot.rev{opacity:1;transform:none}
.rshot svg{display:block;width:100%;height:auto}
.rshot .r-chips{display:flex;flex-wrap:wrap;gap:5px;padding:10px}
.rchip{font-size:10.5px;border:1px solid var(--line);border-radius:999px;padding:4px 10px;color:var(--dim);transition:all .15s}
.rchip:hover{color:var(--fg);border-color:var(--dim)}
.rchip.on{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}

/* art direction brief */
.brief-line{display:flex;gap:14px;padding:11px 0;border-bottom:1px solid var(--line);opacity:0;align-items:baseline;cursor:pointer;transition:background .15s}
.brief-line:hover{background:rgba(255,255,255,.02)}
.brief-line.typed{animation:dRow .45s var(--ease) forwards}
.brief-line .bl-k{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--dim);width:110px;flex:none}
.brief-line .bl-v{font-size:14px;flex:1}
.brief-line .bl-v .cursor{display:inline-block;width:8px;height:15px;background:var(--accent);animation:blink .7s steps(1) infinite;vertical-align:text-bottom}
@keyframes blink{50%{opacity:0}}
.brief-line.avoid .bl-k{color:#e8a13c}
.brief-line.struck .bl-v{text-decoration:line-through;opacity:.4}
.bl-hint{font-size:11px;color:var(--faint);margin-top:10px}

/* brand brief artefact */
#brief-art{border:1px solid var(--accent);border-radius:18px;padding:0;overflow:hidden;perspective:1200px}
#brief-flip{transition:transform .7s var(--ease);transform-style:preserve-3d;position:relative}
#brief-flip.flipped{transform:rotateY(180deg)}
.bf-face{backface-visibility:hidden;padding:30px}
.bf-back{position:absolute;inset:0;transform:rotateY(180deg);background:var(--card2);overflow:auto}
.bf-back pre{font-size:10.5px;line-height:1.55;color:var(--dim);font-family:ui-monospace,monospace;white-space:pre-wrap}
.brief-row{display:flex;gap:14px;padding:9px 0;border-bottom:1px solid var(--line);opacity:0;animation:dRow .4s var(--ease) forwards;cursor:pointer;align-items:baseline}
.brief-row:hover .br-v{color:var(--accent)}
.brief-row .br-k{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--dim);width:120px;flex:none}
.brief-row .br-v{font-size:14px;flex:1;transition:color .15s}

/* candidates */
.cgrid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:8px}
.ccard{background:var(--card2);border:1px solid var(--line);border-radius:14px;overflow:hidden;transition:all .2s var(--ease);animation:fadeUp .5s var(--ease) both;position:relative}
.ccard:hover{border-color:var(--dim);transform:translateY(-2px)}
.ccard.cmp{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent)}
.ccard .c-mock{height:150px;position:relative;overflow:hidden}
.ccard .c-body{padding:16px 18px 18px}
.ccard .c-dir{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--dim);margin-bottom:4px}
.ccard .c-logo{height:52px;display:flex;align-items:center;margin:4px 0 8px}
.ccard .c-pal{display:flex;gap:4px;margin-bottom:8px}
.ccard .c-pal i{width:22px;height:12px;border-radius:3px;display:block}
.ccard .c-type{font-size:11px;color:var(--dim);margin-bottom:12px}
.ccard .c-acts{display:flex;gap:8px;align-items:center}
.cmp-bar{display:flex;gap:10px;align-items:center;margin-top:14px;font-size:12px;color:var(--dim)}

/* takeovers */
#gen-ov .gen-blobs{position:absolute;inset:0;overflow:hidden;filter:blur(46px) saturate(1.2);opacity:.55}
.gblob{position:absolute;width:340px;height:340px;border-radius:50%;animation:blob 5s ease-in-out infinite alternate}
@keyframes blob{from{transform:translate(-40px,-30px) scale(.9)}to{transform:translate(50px,40px) scale(1.15)}}
.gen-status{position:relative;z-index:2;text-align:center}
.gen-status .gs-sub{color:var(--dim);font-size:13px;margin-top:14px;letter-spacing:.08em}
#act-ov{z-index:150}
.act-stage{width:min(760px,80vw);text-align:center}
.act-mock{height:340px;border-radius:18px;overflow:hidden;border:1px solid var(--line);margin:24px auto;position:relative;transition:opacity .5s}
.act-cap{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--dim)}

@media (prefers-reduced-motion: reduce){
  *{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.15s !important}
  .agent-line .w{animation:none;opacity:1}
}
</style>
</head>
<body>

<div id="rail"><span class="rail-label">Insights</span></div>
<div id="spine"></div>
<div id="bspine"></div>
<div id="colorwash"></div>
<main id="stage"><div id="stream"></div></main>

<script>
"use strict";
/* ═══════════════ HELPERS & STATE ═══════════════ */
function esc(s){return String(s).replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];});}
function el(html){var d=document.createElement("div");d.innerHTML=html.trim();return d.firstChild;}
var REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
var stream = null;

var STATE = {
  project_id:"prj_0192",
  name:null, byline:true, building_names:[],
  personas:[], tone_of_voice:{warm_restrained:.3,confident_understated:.55,local_international:.65,approved_headline:null},
  direction:null,
  axes:{logo:null,photography:null,lifestyle:null,render:null},
  art_direction:null,
  moodboard_refs:null,
  insights:[],
  locked_at:null,
  session:{resumable:true,completed_beats:[]}
};

var BEATS = ["Dossier","Story","Name","Personas","Tone","Direction","Taste","Art direction","Brief","Brand"];
var curBeat = 0;

function buildSpine(){
  var sp=document.getElementById("spine");
  BEATS.forEach(function(b,i){
    var n=el('<div class="snode" data-i="'+i+'"><span class="stip">'+esc(b)+'</span></div>');
    n.onclick=function(){ if(n.classList.contains("done")){ var r=document.getElementById("receipt-b"+(i+1)); if(r) r.scrollIntoView({behavior:"smooth",block:"center"}); } };
    sp.appendChild(n);
  });
}
function setBeat(i){
  curBeat=i;
  document.querySelectorAll("#spine .snode").forEach(function(n,j){
    n.classList.toggle("done", j<i);
    n.classList.toggle("now", j===i);
  });
}
function completeBeat(id){ if(STATE.session.completed_beats.indexOf(id)<0) STATE.session.completed_beats.push(id); }

/* typeset agent line: word-by-word fade */
function agentSay(text, sub){
  return new Promise(function(res){
    var line=el('<div class="agent-line"></div>');
    stream.appendChild(line);
    var words=text.split(" ");
    if(REDUCED){ line.textContent=text; }
    else words.forEach(function(w,i){
      var s=el('<span class="w">'+esc(w)+" </span>");
      s.style.animationDelay=(i*45)+"ms";
      line.appendChild(s);
    });
    if(sub){
      var sb=el('<div class="agent-sub"></div>'); sb.textContent=sub;
      sb.style.opacity="0";
      stream.appendChild(sb);
      setTimeout(function(){ sb.style.transition="opacity .5s"; sb.style.opacity="1"; }, REDUCED?0:words.length*45+150);
    }
    scrollEnd();
    setTimeout(res, REDUCED?50:Math.min(words.length*45+250, 2200));
  });
}
function userSaid(text){
  stream.appendChild(el('<div class="user-line"><span>'+esc(text)+'</span></div>'));
  scrollEnd();
}
function addCard(html, tag){
  var c=el('<div class="card">'+(tag?'<div class="card-tag">'+esc(tag)+'</div>':'')+html+'</div>');
  stream.appendChild(c); scrollEnd(); return c;
}
function scrollEnd(){ setTimeout(function(){ window.scrollTo({top:document.body.scrollHeight,behavior:REDUCED?"auto":"smooth"}); },60); }
function wait(ms){ return new Promise(function(r){ setTimeout(r, REDUCED?Math.min(ms,120):ms); }); }

function addReceipt(beatNum, label, val, onReopen){
  var r=el('<div class="receipt" id="receipt-b'+beatNum+'"><div class="r-check">✓</div><div class="r-label">'+esc(label)+'</div><div class="r-val">'+val+'</div><div class="r-edit">edit</div></div>');
  r.onclick=function(){ if(onReopen) onReopen(r); };
  stream.appendChild(r); scrollEnd(); return r;
}
function updateReceipt(beatNum, val){
  var r=document.getElementById("receipt-b"+beatNum);
  if(r) r.querySelector(".r-val").innerHTML=val;
}
function addInsight(text){
  STATE.insights.push(text);
  var c=el('<div class="ichip">'+esc(text)+'</div>');
  document.getElementById("rail").appendChild(c);
}

/* ═══════════════ DATA ═══════════════ */
var SEED = {
  developer:"Falzon Group",
  location:"Tigné seafront, Sliema, Malta",
  units:"24 units — 6×2-bed · 3×3-bed · 1 penthouse · 14×1-bed",
  tier:"Mid-to-upper",
  files:"Architectural drawings · Floor plans · Availability CSV"
};

var DIRECTIONS = {
  heritage:{slug:"heritage",name:"Heritage / Timeless",kw:"permanence · legacy · refined",
    pal:["#2B2620","#6B5D4F","#B08D57","#D9CDBA","#8C8478"],
    type:{disp:"'Cormorant Garamond',serif",dispW:"600",body:"'Space Grotesk',sans-serif",label:"Serif display · humanist body"},
    pos:"For buyers who want an address with a past — and a future.",
    accent:"#B08D57",accentInk:"#1d1812",bg:"#0d0b09"},
  minimal:{slug:"minimal",name:"Modern Minimal",kw:"clean · architectural · quiet",
    pal:["#F4F2EE","#1B1B1D","#3A3A3E","#C9C7C2","#77767A"],
    type:{disp:"'Space Grotesk',sans-serif",dispW:"300",body:"'Space Grotesk',sans-serif",label:"Light grotesk · generous space"},
    pos:"For people who read a floor plan like a manifesto.",
    accent:"#DDDBD5",accentInk:"#141416",bg:"#0b0b0c"},
  organic:{slug:"organic",name:"Warm Organic",kw:"natural · calm · tactile",
    pal:["#D9C7A7","#8A9B77","#C0704D","#7A6248","#EDE6D6"],
    type:{disp:"'Space Grotesk',sans-serif",dispW:"500",body:"'Space Grotesk',sans-serif",label:"Humanist grotesk · soft rhythm"},
    pos:"For families who want home to feel grown, not built.",
    accent:"#C0704D",accentInk:"#17100b",bg:"#0d0c09"},
  coastal:{slug:"coastal",name:"Coastal / Resort",kw:"light · airy · leisure",
    pal:["#F5F1E8","#2E5266","#C9B99B","#9FB8C4","#DCD5C4"],
    type:{disp:"'Cormorant Garamond',serif",dispW:"500",body:"'Space Grotesk',sans-serif",label:"Relaxed serif · airy grotesk"},
    pos:"For buyers who measure value in metres from the water.",
    accent:"#9FB8C4",accentInk:"#101a20",bg:"#0a0d0f"},
  urban:{slug:"urban",name:"Urban / Metropolitan",kw:"dense · sharp · investor",
    pal:["#17181A","#2E3033","#C8CACD","#E8590C","#57595E"],
    type:{disp:"'Archivo',sans-serif",dispW:"800",body:"'Space Grotesk',sans-serif",label:"Strong grotesk · tight tracking"},
    pos:"For buyers who think in yield and skyline.",
    accent:"#E8590C",accentInk:"#140800",bg:"#0b0b0c"},
  bold:{slug:"bold",name:"Bold / Statement",kw:"expressive · branded · energetic",
    pal:["#EFE9DC","#111114","#E33E5A","#F2B33D","#3548A6"],
    type:{disp:"'Archivo',sans-serif",dispW:"800",body:"'Space Grotesk',sans-serif",label:"Display-weight · graphic shapes"},
    pos:"For projects that intend to be talked about.",
    accent:"#E33E5A",accentInk:"#1c0509",bg:"#0c0a0b"}
};
var PRESENT = ["coastal","organic","minimal"];   // filtered 6→3 for this project
var WILDCARD = "bold";
var EXCLUDED = ["heritage","urban"];

var NAME_SETS = {
  place:[
    {n:"The Salt House",why:"Tigné's shoreline was Sliema's salt-panning frontage — quiet local history, reads premium."},
    {n:"Creekside",why:"Direct nod to Sliema Creek; easy to say in every buyer language."},
    {n:"Tigné Blue",why:"Anchors the address; the colour does the seafront work."}
  ],
  building:[
    {n:"The Ledge",why:"The stepped seafront elevation is the building's signature move."},
    {n:"Horizon Terraces",why:"Every seaward unit owns a terrace line — name the amenity buyers pay for."},
    {n:"The Quarterdeck",why:"Maritime, elevated, matches the penthouse-led massing."}
  ],
  whole:[
    {n:"Meridian Residences",why:"International register for overseas buyers, precise enough for locals."},
    {n:"The Sliema Line",why:"Place plus geometry — the block reads as one clean line from the water."},
    {n:"Aurelia Court",why:"Warm Latin root, golden-hour connotation, works with 'By Falzon Group'."}
  ]
};
var NAME_REGEN = [
  {n:"Saltline",why:"Shorter, sharper cut of the salt-pan story."},
  {n:"The Strand House",why:"Local-literal: the Strand is the address everyone knows."},
  {n:"Vela",why:"One word, maritime, international — 'sail' in Maltese and Italian."},
  {n:"Blue Ledge",why:"Merges the elevation signature with the seafront."},
  {n:"Casa Marisa",why:"Warm, local, personable — names the building like a home."},
  {n:"North Quay",why:"Investor-clean, orientation-true, easy wayfinding."}
];

var PERSONA_SEED = [
  {label:"Overseas investor",type:"investor",mot:"Yield plus holiday use — buys off a screen, decides on numbers and light.",lo:250,hi:400,pin:"targets your 14 one-beds + 6 two-beds · €250–400k",units:"1-bed ×14, 2-bed ×6"},
  {label:"Local upgrader",type:"end_user",mot:"Seafront lifestyle upgrade — selling a maisonette inland, buying the view.",lo:400,hi:600,pin:"targets your 3 three-beds · €400–600k",units:"3-bed ×3"},
  {label:"Penthouse end-gamer",type:"end_user",mot:"One last move — wants the best terrace in Sliema and no compromises.",lo:900,hi:1400,pin:"targets your 1 penthouse · €900k–1.4M",units:"penthouse ×1"}
];

/* tone copy variants — [restrained, mid, warm] chosen by slider 1; slider 3 tweaks register */
function toneCopy(){
  var name = STATE.name || "The Salt House";
  var w = STATE.tone_of_voice.warm_restrained;      // 0 = warm, 1 = restrained
  var c = STATE.tone_of_voice.confident_understated; // 0 = confident, 1 = understated
  var l = STATE.tone_of_voice.local_international;   // 0 = local, 1 = international
  var h, b;
  if(w < .34){
    h = name+". Life at the water's edge.";
    b = l>.5 ? "Twenty-four seafront homes on Tigné, made for slow mornings and long horizons."
             : "Twenty-four homes fuq il-baħar — slow mornings, the Strand at your door.";
  } else if(w < .67){
    h = c<.5 ? name+". The seafront, claimed." : name+". Quietly on the seafront.";
    b = "Twenty-four residences above Sliema Creek, finished with restraint and built to hold their value.";
  } else {
    h = name+". Precision living, Sliema Creek.";
    b = l>.5 ? "A disciplined seafront address. Twenty-four residences, engineered views, nothing surplus."
             : "A disciplined Sliema address. Twenty-four residences, nothing surplus.";
  }
  if(c>.75 && w<.67) h = name+". Where Sliema slows down.";
  return {h:h,b:b};
}
</script>
<script id="beats-1">
"use strict";
/* ═══════════════ B1 · DOSSIER ═══════════════ */
function beat1(){
  setBeat(0);
  agentSay("Before we design anything, let's make sure I've read your project right.").then(function(){
    var rows=[["Developer",SEED.developer],["Location",SEED.location],["Inventory",SEED.units],["Tier",SEED.tier],["On file",SEED.files]];
    var html='';
    rows.forEach(function(r,i){
      html+='<div class="d-row" style="animation-delay:'+(i*260)+'ms"><div class="d-key">'+esc(r[0])+'</div><div class="d-val" contenteditable="true" data-k="'+i+'">'+esc(r[1])+'</div></div>';
    });
    html+='<div class="d-edit-hint">Anything wrong? Tap a line and correct it directly.</div>';
    html+='<div class="actions"><button class="btn-p" id="b1-ok">That\u2019s right \u2192</button></div>';
    var card=addCard(html,"Project dossier");
    document.getElementById("b1-ok").onclick=function(){
      SEED.location   = card.querySelector('[data-k="1"]').textContent.trim() || SEED.location;
      SEED.units      = card.querySelector('[data-k="2"]').textContent.trim() || SEED.units;
      card.remove();
      userSaid("That's right");
      completeBeat("B1");
      addReceipt(1,"Project","24 units · "+esc(SEED.location)+" · "+esc(SEED.tier),function(){
        agentSay("The dossier is locked into the brief — location and inventory feed everything downstream. Change anything by telling me directly.");
      });
      beat2();
    };
  });
}

/* ═══════════════ B2 · STORY MINING ═══════════════ */
var B2_ANSWERS=[];
var B2_QS=[
  {q:"What's the story of this site — anything about the location, history, or surroundings worth building on?",
   chips:["Old fishing harbour frontage","Seafront promenade","New quarter","Former industrial","Nothing notable"],
   hyp:"Tigné's shoreline was Sliema's old salt-panning and fishing frontage — most of the Strand's character comes from that. Worth building on?",
   hypIns:"former fishing harbour frontage"},
  {q:"Who do you picture buying here?",
   chips:["Overseas professionals returning","Local upgraders","Investors","Downsizers","Mixed"],
   hyp:"Seafront Sliema at this tier usually splits between overseas professionals returning to Malta and local upgraders selling inland. Sound like your buyers?",
   hypIns:"buyers: overseas professionals + local upgraders"},
  {q:"Any nearby project you want this to beat?",
   chips:["The Quad","Tigné Point resales","Fort Cambridge","No direct rival"],
   hyp:"The obvious comparable is Tigné Point resale stock — newer finish and real outdoor space would beat it. Is that the fight?",
   hypIns:"rival: Tigné Point resales — beat on finish + outdoor space"}
];
function beat2(){
  setBeat(1); askStory(0);
}
function askStory(i){
  if(i>=B2_QS.length){
    completeBeat("B2");
    addReceipt(2,"Story",B2_ANSWERS.map(esc).join(" · "),function(){
      agentSay("These three insights shape the naming, the personas and the direction filter. Tell me if any of them is off and I'll re-run what depends on it.");
    });
    beat3(); return;
  }
  var item=B2_QS[i];
  agentSay(item.q).then(function(){
    var chips=item.chips.map(function(c,j){
      return '<button class="chip" style="animation-delay:'+(j*70)+'ms" data-v="'+esc(c)+'">'+esc(c)+'</button>';
    }).join("");
    chips+='<button class="chip ghost" data-ns="1">Not sure</button>';
    var card=addCard('<div class="chips">'+chips+'</div>'
      +'<div class="free-row"><input type="text" placeholder="Or tell me in your own words…" maxlength="140"><button class="btn-g">Send</button></div>');
    function lock(ans){
      card.remove(); userSaid(ans); B2_ANSWERS.push(ans); addInsight(ans); askStory(i+1);
    }
    card.querySelectorAll(".chip[data-v]").forEach(function(ch){ ch.onclick=function(){ lock(ch.getAttribute("data-v")); }; });
    var inp=card.querySelector("input"), snd=card.querySelector(".free-row .btn-g");
    function sendFree(){ var v=inp.value.trim(); if(v) lock(v); }
    snd.onclick=sendFree; inp.onkeydown=function(e){ if(e.key==="Enter") sendFree(); };
    card.querySelector("[data-ns]").onclick=function(){
      card.remove(); userSaid("Not sure");
      agentSay(item.hyp,"I looked at the area so you don't have to — confirm or correct me.").then(function(){
        var c2=addCard('<div class="chips"><button class="chip" id="hy-y">Yes, that\u2019s right</button><button class="chip ghost" id="hy-n">Not quite — it\u2019s more…</button></div>'
          +'<div class="free-row" style="display:none"><input type="text" placeholder="Tell me what it really is…" maxlength="140"><button class="btn-g">Send</button></div>');
        c2.querySelector("#hy-y").onclick=function(){ c2.remove(); userSaid("Yes, that's right"); B2_ANSWERS.push(item.hypIns); addInsight(item.hypIns); askStory(i+1); };
        c2.querySelector("#hy-n").onclick=function(){ c2.querySelector(".free-row").style.display="flex"; c2.querySelector("input").focus(); };
        var i2=c2.querySelector("input"), s2=c2.querySelector(".free-row .btn-g");
        function send2(){ var v=i2.value.trim(); if(!v) return; c2.remove(); userSaid(v); B2_ANSWERS.push(v); addInsight(v); askStory(i+1); }
        s2.onclick=send2; i2.onkeydown=function(e){ if(e.key==="Enter") send2(); };
      });
    };
  });
}

/* ═══════════════ B3 · NAMING ═══════════════ */
var WM_FONTS=["f-serif","f-grot","f-disp"];
var nameRejected=false;
function beat3(){
  setBeat(2);
  agentSay("Names first — everything else hangs off it.","I've gone three ways: from the place, from the building, and from everything together.").then(function(){
    renderNameCard(NAME_SETS,false);
  });
}
function renderNameCard(sets,isRegen){
  var groups=[["From the place",sets.place],["From the building",sets.building],["From the whole picture",sets.whole]];
  if(isRegen) groups=[["Round two — tuned to your constraints",sets.regen]];
  var html='';
  groups.forEach(function(g){
    html+='<div class="ngroup"><div class="ngroup-h">'+esc(g[0])+'</div>';
    g[1].forEach(function(o){
      html+='<div class="nopt" data-n="'+esc(o.n)+'"><div class="n-name">'+esc(o.n)+'</div><div class="n-why">'+esc(o.why)+'</div></div>';
    });
    html+='</div>';
  });
  html+='<div id="wordmark-stage" style="display:none"><div id="wm-name" class="f-serif"></div><div id="wm-by">BY FALZON GROUP</div></div>';
  html+='<div class="toggle-row" id="by-row" style="display:none"><div class="tg on" id="by-tg"></div><span>Show \u201cBy Falzon Group\u201d under the logo</span></div>';
  html+='<div class="free-row"><input type="text" id="own-name" placeholder="Or type your own name…" maxlength="40"><button class="btn-g" id="own-go">Use mine</button></div>';
  html+='<div class="actions"><button class="btn-p" id="n-lock" style="display:none">Lock the name \u2192</button>'
      +(isRegen?'':'<button class="btn-g" id="n-none">None of these work</button>')+'</div>';
  var card=addCard(html,isRegen?"Names · round two":"Name constellations");
  var picked=null, morphTimer=null, morphIdx=0;
  function pick(n){
    picked=n;
    card.querySelectorAll(".nopt").forEach(function(o){ o.classList.toggle("sel",o.getAttribute("data-n")===n); });
    var stage=card.querySelector("#wordmark-stage"); stage.style.display="flex";
    card.querySelector("#by-row").style.display="flex";
    card.querySelector("#n-lock").style.display="inline-block";
    var wm=card.querySelector("#wm-name"); wm.textContent=n;
    clearInterval(morphTimer); morphIdx=0;
    wm.className=WM_FONTS[0];
    if(!REDUCED) morphTimer=setInterval(function(){ morphIdx=(morphIdx+1)%WM_FONTS.length; wm.className=WM_FONTS[morphIdx]; },1400);
    scrollEnd();
  }
  card.querySelectorAll(".nopt").forEach(function(o){ o.onclick=function(){ pick(o.getAttribute("data-n")); }; });
  var tg=card.querySelector("#by-tg");
  tg.onclick=function(){ tg.classList.toggle("on"); STATE.byline=tg.classList.contains("on");
    card.querySelector("#wm-by").style.opacity=STATE.byline?"1":"0"; };
  card.querySelector("#own-go").onclick=function(){
    var v=card.querySelector("#own-name").value.trim();
    if(!v) return;
    pick(v);
    agentSay("\u201c"+v+"\u201d — reads clean, carries well next to \u201cBy Falzon Group\u201d, and it's yours. That matters more than anything I'd propose.");
  };
  card.querySelector("#own-name").onkeydown=function(e){ if(e.key==="Enter") card.querySelector("#own-go").click(); };
  card.querySelector("#n-lock").onclick=function(){
    clearInterval(morphTimer);
    STATE.name=picked; card.remove(); userSaid("Lock \u201c"+picked+"\u201d");
    lockBuildingNames();
  };
  if(!isRegen) card.querySelector("#n-none").onclick=function(){
    clearInterval(morphTimer); card.remove(); userSaid("None of these work");
    nameConstraints();
  };
}
function nameConstraints(){
  agentSay("Fair — no forcing it. Two quick constraints and I'll go again.").then(function(){
    agentSay("What should it sound like?").then(function(){
      var c=addCard('<div class="chips">'+["Shorter","More local","More international","More literal","More abstract"].map(function(x){return '<button class="chip">'+x+'</button>';}).join("")+'</div>');
      c.querySelectorAll(".chip").forEach(function(ch){ ch.onclick=function(){
        var v1=ch.textContent; c.remove(); userSaid(v1);
        agentSay("Anything to avoid — words, themes, competitors' territory?").then(function(){
          var c2=addCard('<div class="free-row"><input type="text" placeholder="e.g. no \u2018Tign\u00e9\u2019, nothing nautical…" maxlength="80"><button class="btn-g">Send</button></div><div class="chips"><button class="chip ghost">Nothing specific</button></div>');
          function done(v2){
            c2.remove(); userSaid(v2);
            agentSay("Regenerating with that — "+v1.toLowerCase()+", avoiding "+v2.toLowerCase()+".").then(function(){
              nameRejected=true;
              renderNameCard({regen:NAME_REGEN},true);
            });
          }
          c2.querySelector(".btn-g").onclick=function(){ var v=c2.querySelector("input").value.trim(); done(v||"nothing specific"); };
          c2.querySelector("input").onkeydown=function(e){ if(e.key==="Enter") c2.querySelector(".btn-g").click(); };
          c2.querySelector(".chip").onclick=function(){ done("Nothing specific"); };
        });
      };});
    });
  });
}
function lockBuildingNames(){
  agentSay("\u201c"+STATE.name+"\u201d it is. One block, so no building-name family needed — the project name carries it all.").then(function(){
    STATE.building_names=[STATE.name];
    completeBeat("B3");
    addReceipt(3,"Name","<b style='font-weight:600'>"+esc(STATE.name)+"</b>"+(STATE.byline?" · By Falzon Group":""),function(){
      reopenName();
    });
    beat4();
  });
}
function reopenName(){
  agentSay("Rename it? Everything verbal downstream — tone samples, headlines — will re-derive.").then(function(){
    var c=addCard('<div class="free-row"><input type="text" placeholder="New name…" maxlength="40" value="'+esc(STATE.name)+'"><button class="btn-p">Update</button></div><div class="chips"><button class="chip ghost">Keep it</button></div>');
    c.querySelector(".btn-p").onclick=function(){
      var v=c.querySelector("input").value.trim(); if(!v) return;
      STATE.name=v; c.remove(); userSaid("Rename to \u201c"+v+"\u201d");
      updateReceipt(3,"<b style='font-weight:600'>"+esc(v)+"</b>"+(STATE.byline?" · By Falzon Group":""));
      agentSay("Done — \u201c"+v+"\u201d is the name everywhere now.");
    };
    c.querySelector(".chip").onclick=function(){ c.remove(); };
  });
}

/* ═══════════════ B4 · PERSONAS ═══════════════ */
function beat4(){
  setBeat(3);
  agentSay("Based on your mix — fourteen one-beds, six two-beds, three three-beds and the penthouse — and what you told me about buyers, here's who we're really selling to.",
    "Every persona is pinned to real inventory. A persona with nothing to buy is noise.").then(function(){
    STATE.personas = PERSONA_SEED.slice(0,2).map(function(p){ return JSON.parse(JSON.stringify(p)); });
    renderPersonas();
  });
}
function personaCardHTML(p,i){
  return '<div class="pcard" style="animation-delay:'+(i*140)+'ms" data-i="'+i+'">'
    +'<button class="p-x" title="Remove">\u2715</button>'
    +'<div class="p-type">'+esc(p.type==="investor"?"Investor":"End user")+'</div>'
    +'<h4>'+esc(p.label)+'</h4>'
    +'<div class="p-mot">'+esc(p.mot)+'</div>'
    +'<div class="p-band">\u20ac<span class="p-lo">'+p.lo+'</span>k \u2013 \u20ac<span class="p-hi">'+p.hi+'</span>k</div>'
    +'<input type="range" min="150" max="1500" step="10" value="'+p.hi+'">'
    +'<div class="p-pin">\u2192 '+esc(p.pin)+'</div>'
    +'</div>';
}
function renderPersonas(){
  var html='<div class="pgrid" id="pgrid">'+STATE.personas.map(personaCardHTML).join("")+'</div>'
    +'<div class="actions"><button class="btn-p" id="p-ok">These are our buyers \u2192</button><button class="btn-g" id="p-add">+ one more</button></div>';
  var card=addCard(html,"Buyer personas");
  wirePersonas(card);
  card.querySelector("#p-ok").onclick=function(){
    card.remove(); userSaid("These are our buyers");
    completeBeat("B4");
    addReceipt(4,"Personas",STATE.personas.map(function(p){return esc(p.label);}).join(" · "),function(){
      agentSay("Personas drive every later targeting and creative call. Reopen them by telling me what changed — a band, a buyer type, a motivation.");
    });
    beat5();
  };
  card.querySelector("#p-add").onclick=function(){
    if(STATE.personas.length>=3){ agentSay("Three is plenty — more personas dilute the targeting."); return; }
    var p=JSON.parse(JSON.stringify(PERSONA_SEED[2]));
    STATE.personas.push(p);
    card.querySelector("#pgrid").insertAdjacentHTML("beforeend",personaCardHTML(p,STATE.personas.length-1));
    wirePersonas(card);
    agentSay("Added the penthouse buyer — one unit, one persona, but it's the unit that sets the project's ceiling price, so worth naming.");
    scrollEnd();
  };
}
function wirePersonas(card){
  card.querySelectorAll(".pcard").forEach(function(pc){
    if(pc.dataset.wired) return; pc.dataset.wired="1";
    var i=+pc.getAttribute("data-i");
    pc.querySelector("input[type=range]").oninput=function(){
      var p=STATE.personas[i]; if(!p) return;
      p.hi=+this.value;
      pc.querySelector(".p-hi").textContent=p.hi;
      var pin=pc.querySelector(".p-pin");
      if(p.hi<250){ pin.textContent="\u26a0 nothing in your inventory under \u20ac250k — drop this persona or lift the band"; pin.classList.add("warn"); }
      else { pin.textContent="\u2192 "+p.pin; pin.classList.remove("warn"); }
    };
    pc.querySelector(".p-x").onclick=function(){
      STATE.personas[i]=null; pc.remove();
      STATE.personas=STATE.personas.filter(Boolean);
    };
  });
}

/* ═══════════════ B5 · TONE ═══════════════ */
function beat5(){
  setBeat(4);
  agentSay("Now the voice. I've set these where I think you sit — warm but composed, confident, leaning international for your overseas buyers.",
    "Move any slider and watch the copy rewrite itself. That headline is your project speaking.").then(function(){
    var sliders=[
      {k:"warm_restrained",a:"Warm",b:"Restrained"},
      {k:"confident_understated",a:"Confident",b:"Understated"},
      {k:"local_international",a:"Local",b:"International"}
    ];
    var html=sliders.map(function(s){
      return '<div class="slider-row"><div class="s-labels"><span>'+s.a+'</span><span>'+s.b+'</span></div>'
        +'<input type="range" min="0" max="100" value="'+Math.round(STATE.tone_of_voice[s.k]*100)+'" data-k="'+s.k+'"></div>';
    }).join("");
    html+='<div id="tone-preview"><div id="tone-h"></div><div id="tone-b"></div></div>';
    html+='<div class="actions"><button class="btn-p" id="t-ok">This is our voice \u2192</button></div>';
    var card=addCard(html,"Tone of voice");
    function refresh(){
      var c=toneCopy();
      var h=card.querySelector("#tone-h"), b=card.querySelector("#tone-b");
      h.style.opacity="0"; b.style.opacity="0";
      setTimeout(function(){ h.textContent=c.h; b.textContent=c.b; h.style.opacity="1"; b.style.opacity="1"; },REDUCED?0:180);
    }
    card.querySelectorAll("input[type=range]").forEach(function(r){
      r.oninput=function(){ STATE.tone_of_voice[r.getAttribute("data-k")]=+r.value/100; refresh(); };
    });
    refresh();
    card.querySelector("#t-ok").onclick=function(){
      STATE.tone_of_voice.approved_headline=toneCopy().h;
      card.remove(); userSaid("This is our voice");
      completeBeat("B5");
      addReceipt(5,"Tone","\u201c"+esc(STATE.tone_of_voice.approved_headline)+"\u201d",function(){
        agentSay("Tone is on the BrandKit. Every headline, brochure line and ad inherits it — reopen it by telling me what reads wrong.");
      });
      agentSay("That's the words locked. Now let's find what this looks like.").then(beat6);
    };
  });
}
</script>
<script id="beats-2">
"use strict";
/* ═══════════════ COMPOSED ART (placeholder library, spec §9) ═══════════════ */
function heroSVG(d){
  var p=d.pal;
  return '<svg viewBox="0 0 520 640" preserveAspectRatio="xMidYMid slice" style="position:absolute;inset:0;width:100%;height:100%">'
    +'<defs><linearGradient id="sky-'+d.slug+'" x1="0" y1="0" x2="0" y2="1">'
    +'<stop offset="0" stop-color="'+p[0]+'"/><stop offset="1" stop-color="'+p[3]+'"/></linearGradient>'
    +'<linearGradient id="sea-'+d.slug+'" x1="0" y1="0" x2="0" y2="1">'
    +'<stop offset="0" stop-color="'+p[1]+'"/><stop offset="1" stop-color="'+p[0]+'" stop-opacity=".4"/></linearGradient></defs>'
    +'<rect width="520" height="640" fill="url(#sky-'+d.slug+')"/>'
    +'<circle cx="390" cy="150" r="58" fill="'+p[2]+'" opacity=".85"/>'
    +'<rect y="430" width="520" height="210" fill="url(#sea-'+d.slug+')"/>'
    // stepped building silhouette
    +'<g fill="'+p[1]+'"><rect x="60" y="250" width="130" height="190"/><rect x="190" y="200" width="120" height="240"/><rect x="310" y="290" width="110" height="150"/></g>'
    +'<g fill="'+p[4]+'" opacity=".9"><rect x="60" y="244" width="130" height="6"/><rect x="190" y="194" width="120" height="6"/><rect x="310" y="284" width="110" height="6"/></g>'
    // window grid
    +'<g fill="'+p[3]+'" opacity=".75">'
    +[0,1,2,3].map(function(r){return [0,1,2].map(function(c){return '<rect x="'+(74+c*40)+'" y="'+(270+r*40)+'" width="24" height="26" rx="2"/>';}).join("");}).join("")
    +[0,1,2,3,4].map(function(r){return [0,1].map(function(c){return '<rect x="'+(206+c*52)+'" y="'+(218+r*42)+'" width="34" height="28" rx="2"/>';}).join("");}).join("")
    +'</g>'
    +'<rect x="0" y="430" width="520" height="3" fill="'+p[2]+'" opacity=".8"/>'
    +'</svg>';
}
function matStyle(hex,mode){
  if(mode===1) return "background:repeating-linear-gradient(45deg,"+hex+","+hex+" 6px,rgba(0,0,0,.18) 6px,rgba(0,0,0,.18) 8px)";
  if(mode===2) return "background:radial-gradient(circle at 30% 30%,rgba(255,255,255,.28),transparent 60%),"+hex;
  if(mode===3) return "background:repeating-linear-gradient(0deg,"+hex+","+hex+" 9px,rgba(255,255,255,.1) 9px,rgba(255,255,255,.1) 11px)";
  return "background:linear-gradient(135deg,"+hex+",rgba(0,0,0,.25))";
}
function totArt(axis,pole,d){
  var p=d.pal;
  var svg='';
  if(axis==="logo"){
    svg = pole==="wordmark"
      ? '<div style="position:absolute;inset:0;background:'+p[0]+';display:flex;align-items:center;justify-content:center"><div style="font-family:'+d.type.disp+';font-weight:'+d.type.dispW+';font-size:30px;color:'+p[1]+';letter-spacing:.06em">'+esc(STATE.name||"Salt House")+'</div></div>'
      : '<div style="position:absolute;inset:0;background:'+p[0]+';display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px"><svg width="72" height="72" viewBox="0 0 72 72"><circle cx="36" cy="36" r="30" fill="none" stroke="'+p[1]+'" stroke-width="4"/><path d="M14 42 Q26 30 36 42 T58 42" fill="none" stroke="'+p[2]+'" stroke-width="4" stroke-linecap="round"/></svg><div style="font-size:11px;letter-spacing:.3em;color:'+p[1]+'">'+esc((STATE.name||"SALT HOUSE").toUpperCase())+'</div></div>';
  } else if(axis==="photography"){
    svg = pole==="people"
      ? '<div style="position:absolute;inset:0;background:linear-gradient(180deg,'+p[3]+','+p[0]+')"><svg viewBox="0 0 300 200" preserveAspectRatio="xMidYMid slice" style="width:100%;height:100%"><ellipse cx="110" cy="150" rx="26" ry="60" fill="'+p[1]+'" opacity=".9"/><circle cx="110" cy="78" r="17" fill="'+p[1]+'"/><ellipse cx="170" cy="158" rx="22" ry="52" fill="'+p[4]+'" opacity=".85"/><circle cx="170" cy="94" r="14" fill="'+p[4]+'"/><rect y="186" width="300" height="14" fill="'+p[2]+'" opacity=".7"/></svg></div>'
      : '<div style="position:absolute;inset:0;background:'+p[3]+'"><svg viewBox="0 0 300 200" preserveAspectRatio="xMidYMid slice" style="width:100%;height:100%"><rect x="40" y="30" width="90" height="170" fill="'+p[1]+'"/><rect x="130" y="70" width="70" height="130" fill="'+p[4]+'"/><rect x="200" y="45" width="60" height="155" fill="'+p[1]+'" opacity=".8"/><line x1="0" y1="120" x2="300" y2="120" stroke="'+p[2]+'" stroke-width="3"/></svg></div>';
  } else if(axis==="lifestyle"){
    svg = pole==="quiet"
      ? '<div style="position:absolute;inset:0;background:linear-gradient(180deg,'+p[0]+' 55%,'+p[3]+')"><svg viewBox="0 0 300 200" preserveAspectRatio="xMidYMid slice" style="width:100%;height:100%"><circle cx="240" cy="46" r="26" fill="'+p[2]+'" opacity=".9"/><rect x="30" y="130" width="150" height="8" rx="4" fill="'+p[1]+'"/><rect x="42" y="138" width="10" height="34" fill="'+p[1]+'"/><rect x="158" y="138" width="10" height="34" fill="'+p[1]+'"/><ellipse cx="105" cy="122" rx="14" ry="8" fill="'+p[4]+'"/></svg></div>'
      : '<div style="position:absolute;inset:0;background:'+p[2]+'"><svg viewBox="0 0 300 200" preserveAspectRatio="xMidYMid slice" style="width:100%;height:100%">'+[0,1,2,3,4].map(function(i){return '<circle cx="'+(50+i*50)+'" cy="'+(120+(i%2)*26)+'" r="15" fill="'+p[(i%2)?1:4]+'"/><rect x="'+(41+i*50)+'" y="'+(134+(i%2)*26)+'" width="18" height="46" rx="8" fill="'+p[(i%2)?1:4]+'"/>';}).join("")+'<rect y="0" width="300" height="52" fill="'+p[0]+'" opacity=".55"/></svg></div>';
  } else {
    svg = pole==="warm"
      ? '<div style="position:absolute;inset:0;background:linear-gradient(200deg,#f2b06b 0%,'+p[2]+' 40%,'+p[1]+' 100%)"><svg viewBox="0 0 300 200" preserveAspectRatio="xMidYMid slice" style="width:100%;height:100%"><rect x="70" y="60" width="160" height="140" fill="rgba(0,0,0,.32)"/><rect x="86" y="78" width="30" height="26" fill="#ffd9a0" opacity=".9"/><rect x="126" y="78" width="30" height="26" fill="#ffd9a0" opacity=".75"/><circle cx="252" cy="36" r="20" fill="#ffcf8a"/></svg></div>'
      : '<div style="position:absolute;inset:0;background:linear-gradient(190deg,'+p[3]+' 0%,'+p[0]+' 60%)"><svg viewBox="0 0 300 200" preserveAspectRatio="xMidYMid slice" style="width:100%;height:100%"><rect x="70" y="50" width="160" height="150" fill="'+p[1]+'"/><rect x="86" y="66" width="30" height="26" fill="'+p[3]+'" opacity=".85"/><rect x="126" y="66" width="30" height="26" fill="'+p[3]+'" opacity=".7"/><line x1="0" y1="200" x2="300" y2="200" stroke="'+p[4]+'" stroke-width="6"/></svg></div>';
  }
  return svg;
}

/* ═══════════════ B6 · STAGE 1 — CHOOSE THE WORLD ═══════════════ */
var boardList=[], boardIdx=0, wildShown=false, swapUsed=false;
function beat6(){
  setBeat(5);
  var ov=el('<div class="overlay"><div class="shimmer-text">I\u2019ve read everything you told me. Building your directions\u2026</div></div>');
  document.body.appendChild(ov);
  wait(2300).then(function(){
    ov.remove();
    boardList=PRESENT.slice();
    openBoards();
  });
}
function whyLine(slug){
  var i0=STATE.insights[0]||"the seafront site", i1=STATE.insights[1]||"your buyers";
  var w={
    coastal:"You told me <b>\u201c"+esc(i0)+"\u201d</b> and <b>\u201c"+esc(i1)+"\u201d</b> — this is the world that sells metres-from-the-water, without shouting.",
    organic:"Your buyers upgrading from inland want calm and texture — this direction makes the seafront feel like home, not a resort.",
    minimal:"For overseas professionals buying off a screen, this reads international, disciplined, design-led — the building does the talking.",
    bold:"The wildcard. If you want "+esc(STATE.name||"the project")+" to be the talked-about launch on the Strand, this is how it looks.",
    heritage:"Salt-pan history gives you a legacy story — this direction makes the address feel like it was always here.",
    urban:"Investor-sharp and skyline-first — a harder, yield-led read of the same building."
  };
  return w[slug]||"";
}
function boardHTML(slug){
  var d=DIRECTIONS[slug];
  var pal=d.pal.map(function(h){var light=parseInt(h.slice(1,3),16)>150;return '<div class="swatch" style="background:'+h+'"><span style="color:'+(light?"#00000090":"#ffffffcc")+'">'+h+'</span></div>';}).join("");
  var mats=[matStyle(d.pal[2],0),matStyle(d.pal[1],1),matStyle(d.pal[3],2),matStyle(d.pal[4],3)].map(function(s){return '<div class="mat" style="'+s+'"></div>';}).join("");
  return '<div class="board" style="color:'+(slug==="minimal"?"#f2f0ea":"#f2f0ea")+'">'
    +'<div class="b-hero">'+heroSVG(d)+'</div>'
    +'<div class="b-side" style="background:linear-gradient(180deg,'+d.bg+', #0a0a0b)">'
    +'<div><div class="b-kicker" style="color:'+d.accent+'">Direction</div><div class="b-title">'+esc(d.name)+'</div><div class="b-kw">'+esc(d.kw)+'</div></div>'
    +'<div class="b-pal">'+pal+'</div>'
    +'<div class="b-type-spec"><div class="t-disp" style="font-family:'+d.type.disp+';font-weight:'+d.type.dispW+'">'+esc(STATE.name||"The Salt House")+'</div><div class="t-body">'+esc(d.type.label)+' \u2014 Twenty-four residences above Sliema Creek.</div></div>'
    +'<div class="b-mats">'+mats+'</div>'
    +'<div class="b-pos">\u201c'+esc(d.pos)+'\u201d</div>'
    +'<div class="b-why" style="color:'+d.accent+'">'+whyLine(slug)+'</div>'
    +'<div class="b-pick"><button class="btn-p" style="background:'+d.accent+';color:'+d.accentInk+'" onclick="pickDirection(\''+slug+'\')">This is the world \u2192</button></div>'
    +'</div></div>';
}
function openBoards(){
  boardIdx=0;
  var ov=el('<div class="overlay" id="boards-ov">'
    +'<div class="board-viewport" id="bviewport"></div>'
    +'<button class="board-nav" id="bnav-l">\u2190</button><button class="board-nav" id="bnav-r">\u2192</button>'
    +'<div class="board-footer"><span class="bf-label">Choose the world \u00b7 '+boardList.length+' directions built for your project</span>'
    +(wildShown?'':'<button class="btn-g" id="wild-btn" style="font-size:11px">Show me something unexpected</button>')
    +'<button class="btn-g" id="none-btn" style="font-size:11px">None of these</button></div>'
    +'<div class="board-dots" id="bdots"></div>'
    +'</div>');
  document.body.appendChild(ov);
  function show(){
    document.getElementById("bviewport").innerHTML=boardHTML(boardList[boardIdx]);
    document.getElementById("bdots").innerHTML=boardList.map(function(_,i){return '<div class="bdot'+(i===boardIdx?" on":"")+'"></div>';}).join("");
  }
  document.getElementById("bnav-l").onclick=function(){ boardIdx=(boardIdx-1+boardList.length)%boardList.length; show(); };
  document.getElementById("bnav-r").onclick=function(){ boardIdx=(boardIdx+1)%boardList.length; show(); };
  document.onkeydown=function(e){ if(!document.getElementById("boards-ov"))return; if(e.key==="ArrowLeft")document.getElementById("bnav-l").click(); if(e.key==="ArrowRight")document.getElementById("bnav-r").click(); };
  var wb=document.getElementById("wild-btn");
  if(wb) wb.onclick=function(){ wildShown=true; boardList.push(WILDCARD); boardIdx=boardList.length-1; wb.remove(); show(); };
  document.getElementById("none-btn").onclick=noneFit;
  show();
}
function noneFit(){
  document.getElementById("boards-ov").remove();
  userSaid("None of these feel right");
  if(swapUsed){
    agentSay("Understood — I've logged exactly what's been off, and I'm flagging this for our curation team to build you a custom direction. No forcing a pick that doesn't land.");
    return;
  }
  agentSay("Good to know now rather than after the logo. What's off about them?").then(function(){
    var c=addCard('<div class="chips">'+["Too cold","Too busy","Too traditional","Too safe"].map(function(x){return '<button class="chip">'+x+'</button>';}).join("")+'</div>');
    c.querySelectorAll(".chip").forEach(function(ch){ ch.onclick=function(){
      var fb=ch.textContent; c.remove(); userSaid(fb); swapUsed=true;
      var swap = fb==="Too safe" ? "bold" : fb==="Too traditional" ? "urban" : fb==="Too cold" ? "organic" : "minimal";
      if(boardList.indexOf(swap)>=0) swap = EXCLUDED.concat([WILDCARD]).filter(function(s){return boardList.indexOf(s)<0;})[0];
      boardList=boardList.filter(function(s,i){return i!==0;}); boardList.unshift(swap);
      agentSay("\u201c"+fb+"\u201d — noted. I've swapped in "+DIRECTIONS[swap].name+", the nearest neighbour that answers that. Same three-board choice, one better fit.").then(openBoards);
    };});
  });
}
function applySkin(d){
  var r=document.documentElement.style;
  r.setProperty("--accent",d.accent);
  r.setProperty("--accent-ink",d.accentInk);
  r.setProperty("--bg",d.bg);
  document.body.style.background=d.bg;
}
window.pickDirection=function(slug){
  var d=DIRECTIONS[slug];
  STATE.direction=slug;
  STATE.moodboard_refs={stage1_board:slug+"/stage1",stage2_picks:[]};
  var ovb=document.getElementById("boards-ov"); if(ovb) ovb.remove();
  var wash=document.getElementById("colorwash");
  wash.style.background="linear-gradient(135deg,"+d.pal[1]+","+d.pal[2]+" 55%,"+d.pal[0]+")";
  wash.classList.remove("go"); void wash.offsetWidth; wash.classList.add("go");
  applySkin(d);
  userSaid("This is the world — "+d.name);
  completeBeat("B6");
  addReceipt(6,"Direction","<b style='font-weight:600'>"+esc(d.name)+"</b> · "+esc(d.kw),function(){
    agentSay("Changing the world resets the four taste picks and the art direction — everything visual re-derives. Say the word and I'll reopen the three boards.");
  });
  wait(900).then(function(){
    agentSay("Welcome to "+d.name+". Notice the room changed with you — from here, everything you see is already in your world.").then(beat7);
  });
};

/* ═══════════════ B7 · STAGE 2 — REFINE THE TASTE ═══════════════ */
var AXES=[
  {k:"logo",label:"Logo & mark",a:{v:"wordmark",cap:"Wordmark-led",sub:"The name carries it"},b:{v:"symbol",cap:"Symbol-led",sub:"A mark carries it"},escape:false},
  {k:"photography",label:"Photography",a:{v:"people",cap:"People-led",sub:"Presence and life"},b:{v:"architecture",cap:"Architecture-led",sub:"Form and space"},escape:true},
  {k:"lifestyle",label:"Lifestyle",a:{v:"quiet",cap:"Quiet & aspirational",sub:"Calm scenes"},b:{v:"social",cap:"Social & energetic",sub:"Busy scenes"},escape:true},
  {k:"render",label:"Render",a:{v:"warm",cap:"Warm & lifestyle",sub:"Soft light, styled"},b:{v:"cool",cap:"Cool & editorial",sub:"Crisp, restrained"},escape:false}
];
var escCount={};
function beat7(){
  setBeat(6);
  agentSay("We're inside "+DIRECTIONS[STATE.direction].name+" now. Four quick feels — for each, just tell me which is closer.",
    "There's no wrong answer, and you're not picking your logo yet. Both options live in your world.").then(function(){
    askAxis(0);
  });
}
function bspineAdd(label,val){
  var n=el('<div class="bs-node"><div class="bs-dot"></div><div class="bs-lab">'+esc(label)+' · '+esc(val)+'</div></div>');
  document.getElementById("bspine").appendChild(n);
  requestAnimationFrame(function(){ requestAnimationFrame(function(){ n.classList.add("on"); }); });
}
function askAxis(i,variant){
  if(i>=AXES.length){
    completeBeat("B7");
    var summary=AXES.map(function(ax){return esc(ax.label.split(" ")[0])+": "+esc(STATE.axes[ax.k]);}).join(" · ");
    addReceipt(7,"Taste",summary,function(){
      agentSay("The four axis picks become hard constraints in render prompting and brand generation — tell me which one to flip and I'll re-ask just that pair.");
    });
    agentSay("That's your taste profile — watch the left edge, that spine is your brand building itself. Now let's prove it against your actual building.").then(beat8);
    return;
  }
  var ax=AXES[i], d=DIRECTIONS[STATE.direction];
  var vtag = variant ? " — two more, same axis" : "";
  agentSay((i===0?"First":i===1?"Next":i===2?"Then":"Last")+" — "+ax.label.toLowerCase()+". Which feels closer?"+vtag).then(function(){
    var html='<div class="tot">'
      +'<div class="tot-side" data-p="a"><div class="tot-art">'+totArt(ax.k,ax.a.v,d)+'</div><div class="tot-cap">'+esc(ax.a.cap)+'<small>'+esc(ax.a.sub)+'</small></div></div>'
      +'<div class="tot-side" data-p="b"><div class="tot-art">'+totArt(ax.k,ax.b.v,d)+'</div><div class="tot-cap">'+esc(ax.b.cap)+'<small>'+esc(ax.b.sub)+'</small></div></div>'
      +'</div>';
    if(ax.escape) html+='<div class="actions"><button class="btn-g" id="tot-esc">Neither — show me two more</button></div>';
    var card=addCard(html,"Which feels closer · "+ax.label);
    function lock(pole,cap){
      card.remove(); userSaid(cap);
      STATE.axes[ax.k]=pole;
      STATE.moodboard_refs.stage2_picks.push(STATE.direction+"_stage2_"+ax.k+"_"+pole+"_01.jpg");
      bspineAdd(ax.label,pole);
      askAxis(i+1);
    }
    card.querySelector('[data-p="a"]').onclick=function(){ lock(ax.a.v,ax.a.cap); };
    card.querySelector('[data-p="b"]').onclick=function(){ lock(ax.b.v,ax.b.cap); };
    if(ax.escape) card.querySelector("#tot-esc").onclick=function(){
      card.remove(); userSaid("Neither");
      escCount[ax.k]=(escCount[ax.k]||0)+1;
      if(escCount[ax.k]>=2){ inferAxis(i); }
      else agentSay("No problem — a pick that doesn't land pollutes the brief. Two fresh takes:").then(function(){ askAxis(i,true); });
    };
  });
}
function inferAxis(i){
  var ax=AXES[i];
  agentSay("Let's come at it differently. Describe the photo you'd want on the brochure cover — what's in it?").then(function(){
    var c=addCard('<div class="free-row"><input type="text" placeholder="e.g. a couple on the terrace at dusk…" maxlength="120"><button class="btn-p">Send</button></div>');
    function go(){
      var v=c.querySelector("input").value.trim(); if(!v) return;
      c.remove(); userSaid(v);
      var lv=v.toLowerCase();
      var peopleWords=["couple","people","family","friends","dinner","someone","woman","man","kids","guests","crowd","person"];
      var isPeople = peopleWords.some(function(w){return lv.indexOf(w)>=0;});
      var pole, cap, inference;
      if(ax.k==="photography"){ pole=isPeople?"people":"architecture"; cap=isPeople?"People-led":"Architecture-led";
        inference=isPeople?"That's people-led — presence and life in the frame.":"That's architecture-led — the form and the space carry it."; }
      else { var socialWords=["friends","party","dinner","busy","guests","crowd","music","together"];
        var isSocial=socialWords.some(function(w){return lv.indexOf(w)>=0;});
        pole=isSocial?"social":"quiet"; cap=isSocial?"Social & energetic":"Quiet & aspirational";
        inference=isSocial?"That's social and energetic — scenes with life in motion.":"That's quiet and aspirational — calm, unhurried scenes."; }
      agentSay(inference+" Locking that in — overrule me with one tap if I've read it wrong.").then(function(){
        var c2=addCard('<div class="chips"><button class="chip" id="inf-ok">'+esc(cap)+' is right</button><button class="chip ghost" id="inf-no">No — the other one</button></div>');
        c2.querySelector("#inf-ok").onclick=function(){ c2.remove(); userSaid(cap+" is right");
          STATE.axes[ax.k]=pole; STATE.moodboard_refs.stage2_picks.push(STATE.direction+"_stage2_"+ax.k+"_"+pole+"_01.jpg");
          bspineAdd(ax.label,pole); askAxis(i+1); };
        c2.querySelector("#inf-no").onclick=function(){ c2.remove(); userSaid("The other one");
          var other = pole===ax.a.v ? ax.b : ax.a;
          STATE.axes[ax.k]=other.v; STATE.moodboard_refs.stage2_picks.push(STATE.direction+"_stage2_"+ax.k+"_"+other.v+"_01.jpg");
          bspineAdd(ax.label,other.v); askAxis(i+1); };
      });
    }
    c.querySelector(".btn-p").onclick=go;
    c.querySelector("input").onkeydown=function(e){ if(e.key==="Enter") go(); };
  });
}
</script>
<script id="beats-3">
"use strict";
/* ═══════════════ B8 · PHASE 0 RENDERS + ART DIRECTION ═══════════════ */
function renderSVG(kind){
  var d=DIRECTIONS[STATE.direction], p=d.pal;
  var sky = kind==="dusk" ? '<linearGradient id="rsky'+kind+'" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#31405c"/><stop offset="1" stop-color="#c98d5a"/></linearGradient>'
          : '<linearGradient id="rsky'+kind+'" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a9bfcc"/><stop offset="1" stop-color="#e8e2d2"/></linearGradient>';
  var body = kind==="detail"
    ? '<g><rect x="0" y="0" width="300" height="220" fill="#cfc9ba"/><g fill="#a89f8d">'+[0,1,2].map(function(r){return [0,1,2,3].map(function(c){return '<rect x="'+(18+c*72)+'" y="'+(20+r*70)+'" width="52" height="50" rx="3"/>';}).join("");}).join("")+'</g><rect x="0" y="106" width="300" height="8" fill="#8f8672"/></g>'
    : '<g><rect width="300" height="220" fill="url(#rsky'+kind+')"/>'
      +'<rect y="170" width="300" height="50" fill="'+(kind==="dusk"?"#22303f":"#7fa3b5")+'"/>'
      +'<g fill="'+(kind==="dusk"?"#3d3a33":"#b5ad9c")+'"><rect x="30" y="70" width="80" height="100"/><rect x="110" y="46" width="76" height="124"/><rect x="186" y="88" width="70" height="82"/></g>'
      +'<g fill="'+(kind==="dusk"?"#f0c98c":"#e8e2d2")+'" opacity=".85">'+[0,1,2].map(function(r){return [0,1].map(function(c){return '<rect x="'+(122+c*34)+'" y="'+(58+r*36)+'" width="22" height="22" rx="2"/>';}).join("");}).join("")+'</g>'
      +(kind==="dusk"?'<circle cx="258" cy="34" r="14" fill="#f5d9a8"/>':'<circle cx="250" cy="36" r="20" fill="#fff" opacity=".8"/>')
      +'</g>';
  return '<svg viewBox="0 0 300 220">'+sky+body+'</svg>';
}
var RENDER_SHOTS=[
  {kind:"day",cap:"North-west face, mid-morning"},
  {kind:"dusk",cap:"Seafront elevation, last light"},
  {kind:"detail",cap:"Facade detail, limestone grid"}
];
var reactions=[];
function beat8(){
  setBeat(7);
  agentSay("This is your building, before any brand.","Three neutral hero shots — honest massing, real materials, no styling. Tell me what resonates. Tap anything that lands.").then(function(){
    var html='<div class="rgal">'+RENDER_SHOTS.map(function(s,i){
      return '<div class="rshot" data-i="'+i+'">'+renderSVG(s.kind)
        +'<div class="r-chips">'+["the light","the angle","the mood","the materials"].map(function(r){return '<button class="rchip" data-r="'+r+'">'+r+'</button>';}).join("")+'</div>'
        +'<div style="padding:0 10px 10px;font-size:10px;color:var(--dim)">'+esc(s.cap)+'</div></div>';
    }).join("")+'</div>'
    +'<div class="free-row"><input type="text" placeholder="Or describe what you\u2019re drawn to…" maxlength="140"><button class="btn-g">Add</button></div>'
    +'<div class="actions"><button class="btn-p" id="r-done">That\u2019s what resonates \u2192</button><button class="btn-g" id="r-stuck">Hard to say</button></div>';
    var card=addCard(html,"Phase 0 · your building, unbranded");
    card.querySelectorAll(".rshot").forEach(function(rs,i){ setTimeout(function(){ rs.classList.add("rev"); }, REDUCED?0:400+i*550); });
    card.querySelectorAll(".rchip").forEach(function(ch){
      ch.onclick=function(){ ch.classList.toggle("on");
        var shot=RENDER_SHOTS[+ch.closest(".rshot").getAttribute("data-i")];
        var tag=ch.getAttribute("data-r")+" · "+shot.cap.toLowerCase();
        var idx=reactions.indexOf(tag);
        if(ch.classList.contains("on")) reactions.push(tag); else if(idx>=0) reactions.splice(idx,1);
      };
    });
    var inp=card.querySelector("input");
    card.querySelector(".free-row .btn-g").onclick=function(){ var v=inp.value.trim(); if(v){ reactions.push(v); userSaid(v); inp.value=""; } };
    inp.onkeydown=function(e){ if(e.key==="Enter") card.querySelector(".free-row .btn-g").click(); };
    card.querySelector("#r-done").onclick=function(){
      if(!reactions.length) reactions.push("the light · last light elevation");
      card.remove(); userSaid("That's what resonates");
      writeArtDirection();
    };
    card.querySelector("#r-stuck").onclick=function(){ card.remove(); userSaid("Hard to say"); cropChoice(); };
  });
}
function cropChoice(){
  var d=DIRECTIONS[STATE.direction];
  agentSay("Then let's make it binary. Same shot, two treatments — which is closer?").then(function(){
    var html='<div class="tot">'
      +'<div class="tot-side" data-p="warm"><div class="tot-art">'+totArt("render","warm",d)+'</div><div class="tot-cap">Warm late light<small>Low sun, long shadows</small></div></div>'
      +'<div class="tot-side" data-p="cool"><div class="tot-art">'+totArt("render","cool",d)+'</div><div class="tot-cap">Cool morning light<small>Crisp, even, editorial</small></div></div>'
      +'</div>';
    var card=addCard(html,"Forced choice · light treatment");
    card.querySelectorAll(".tot-side").forEach(function(s){
      s.onclick=function(){
        var p=s.getAttribute("data-p");
        card.remove(); userSaid(p==="warm"?"Warm late light":"Cool morning light");
        reactions.push(p==="warm"?"the light · warm, late-afternoon":"the light · cool, editorial morning");
        agentSay("Good — that tells me plenty. Inferring the rest from your direction and taste picks.").then(writeArtDirection);
      };
    });
  });
}
var BRIEF_LINES=[];
function buildBriefLines(){
  var d=DIRECTIONS[STATE.direction];
  var warm = STATE.axes.render==="warm";
  var lightPick = reactions.some(function(r){return r.indexOf("cool")>=0;}) ? false : warm;
  BRIEF_LINES=[
    {k:"Mood",v:[STATE.axes.lifestyle==="quiet"?"warm minimalism, unhurried":"bright, social, alive",STATE.axes.lifestyle==="quiet"?"serene and assured, never staged":"energetic but composed"],avoid:false},
    {k:"Light",v:[lightPick?"late-afternoon, low contrast, long shadows":"cool morning light, crisp and even","golden-hour only for hero shots, neutral daylight elsewhere"],avoid:false},
    {k:"Palette intent",v:[d.pal.slice(0,3).join(" · ")+" — from your locked direction","lean on "+d.pal[1]+" for depth, "+d.pal[2]+" as the warm accent"],avoid:false},
    {k:"Materials",v:["limestone, pale oak, linen — honest and local","natural stone and soft textiles, nothing lacquered"],avoid:false},
    {k:"Composition",v:[(STATE.axes.photography==="architecture"?"form-first framing; ":"people in frame, mid-distance; ")+"investor shots favour the building, lifestyle shots favour the terrace","calm, uncluttered frames — one subject per image"],avoid:false},
    {k:"Avoid",v:["cool blue tones, busy staging, aerial-only heroes","fisheye angles, crowded scenes, stock-photo gloss"],avoid:true}
  ];
}
function writeArtDirection(){
  buildBriefLines();
  agentSay("Here's the art direction — written from your direction, your taste picks, and what you just reacted to.",
    "Specific beats poetic. Tap any line you disagree with and I'll rewrite just that line.").then(function(){
    var html=BRIEF_LINES.map(function(l,i){
      return '<div class="brief-line'+(l.avoid?" avoid":"")+'" data-i="'+i+'"><div class="bl-k">'+esc(l.k)+'</div><div class="bl-v"></div></div>';
    }).join("");
    html+='<div class="bl-hint">Tap a line to rewrite it · the Avoid list is as binding as the rest</div>';
    html+='<div class="actions"><button class="btn-p" id="ad-ok" style="display:none">Approve the art direction \u2192</button></div>';
    var card=addCard(html,"Art direction");
    typeLines(card,0);
    card.querySelectorAll(".brief-line").forEach(function(bl){
      bl.onclick=function(){
        var i=+bl.getAttribute("data-i"), l=BRIEF_LINES[i];
        if(!bl.classList.contains("typed")) return;
        bl.classList.add("struck");
        setTimeout(function(){
          l.cur = (l.cur===1)?0:1;
          bl.classList.remove("struck");
          typeInto(bl.querySelector(".bl-v"), l.v[l.cur]);
        },REDUCED?50:450);
      };
    });
    card.querySelector("#ad-ok").onclick=function(){
      STATE.art_direction={
        mood:BRIEF_LINES[0].v[BRIEF_LINES[0].cur||0],
        light:BRIEF_LINES[1].v[BRIEF_LINES[1].cur||0],
        palette_intent:DIRECTIONS[STATE.direction].pal.slice(0,3),
        materials:BRIEF_LINES[3].v[BRIEF_LINES[3].cur||0].split(",").slice(0,3).map(function(s){return s.trim();}),
        composition:BRIEF_LINES[4].v[BRIEF_LINES[4].cur||0],
        avoid:BRIEF_LINES[5].v[BRIEF_LINES[5].cur||0].split(",").map(function(s){return s.trim();})
      };
      card.remove(); userSaid("Approve the art direction");
      completeBeat("B8");
      addReceipt(8,"Art direction",esc(STATE.art_direction.mood)+" · "+esc(STATE.art_direction.light),function(){
        agentSay("The art direction is attached to your BrandKit — every render, page and ad inherits it. Tell me which line to rewrite.");
      });
      beat9();
    };
  });
}
function typeLines(card,i){
  if(i>=BRIEF_LINES.length){ var b=card.querySelector("#ad-ok"); b.style.display="inline-block"; scrollEnd(); return; }
  var bl=card.querySelector('[data-i="'+i+'"]');
  bl.classList.add("typed");
  BRIEF_LINES[i].cur=0;
  typeInto(bl.querySelector(".bl-v"),BRIEF_LINES[i].v[0],function(){ typeLines(card,i+1); });
}
function typeInto(elm,text,done){
  if(REDUCED){ elm.textContent=text; if(done)done(); return; }
  elm.innerHTML='<span class="cursor"></span>';
  var i=0;
  var t=setInterval(function(){
    i+=2;
    elm.innerHTML=esc(text.slice(0,i))+'<span class="cursor"></span>';
    if(i>=text.length){ clearInterval(t); elm.textContent=text; if(done)done(); }
  },18);
}

/* ═══════════════ B9 · BRAND BRIEF LOCK ═══════════════ */
function beat9(){
  setBeat(8);
  agentSay("Everything you've decided, in one artefact.","Watch the stream — your receipts are becoming the brief.").then(function(){
    document.querySelectorAll(".receipt").forEach(function(r,i){ setTimeout(function(){ r.classList.add("flying"); },i*120); });
    wait(1100).then(function(){
      document.querySelectorAll(".receipt").forEach(function(r){ r.classList.remove("flying"); });
      var d=DIRECTIONS[STATE.direction];
      var rows=[
        ["Name",esc(STATE.name)+(STATE.byline?" · By Falzon Group":""),3],
        ["Personas",STATE.personas.map(function(p){return esc(p.label);}).join(" · "),4],
        ["Tone","\u201c"+esc(STATE.tone_of_voice.approved_headline)+"\u201d",5],
        ["Direction",esc(d.name),6],
        ["Taste",Object.keys(STATE.axes).map(function(k){return esc(k)+": "+esc(STATE.axes[k]);}).join(" · "),7],
        ["Art direction",esc(STATE.art_direction.mood)+" · "+esc(STATE.art_direction.light),8],
        ["Avoid",STATE.art_direction.avoid.map(esc).join(" · "),8]
      ];
      var front=rows.map(function(r,i){
        return '<div class="brief-row" style="animation-delay:'+(i*140)+'ms" data-b="'+r[2]+'"><div class="br-k">'+esc(r[0])+'</div><div class="br-v">'+r[1]+'</div></div>';
      }).join("");
      var html='<div id="brief-art"><div id="brief-flip">'
        +'<div class="bf-face bf-front"><div class="card-tag">Brand brief · '+esc(STATE.name)+'</div>'+front
        +'<div class="actions"><button class="btn-p" id="brief-lock">Lock the brief \u2192</button><button class="btn-g" id="brief-off">Something\u2019s off</button><button class="btn-g" id="brief-json">view as JSON</button></div>'
        +'<div class="bl-hint">This brief becomes the DNA of every asset — renders, website, brochure, ads. Tap any row to revisit it.</div></div>'
        +'<div class="bf-face bf-back"><pre id="json-pre"></pre><div class="actions"><button class="btn-g" id="brief-json2">back to the brief</button></div></div>'
        +'</div></div>';
      var wrap=el('<div class="card" style="padding:0;border:none;background:none">'+html+'</div>');
      stream.appendChild(wrap); scrollEnd();
      var flip=wrap.querySelector("#brief-flip");
      wrap.querySelector("#brief-json").onclick=function(){
        wrap.querySelector("#json-pre").textContent=JSON.stringify(STATE,null,2);
        flip.classList.add("flipped");
      };
      wrap.querySelector("#brief-json2").onclick=function(){ flip.classList.remove("flipped"); };
      wrap.querySelectorAll(".brief-row").forEach(function(br){
        br.onclick=function(){
          var b=+br.getAttribute("data-b");
          var r=document.getElementById("receipt-b"+b);
          if(r){ r.scrollIntoView({behavior:"smooth",block:"center"}); r.style.borderColor="var(--accent)";
            setTimeout(function(){ r.style.borderColor=""; },1600); r.click(); }
        };
      });
      wrap.querySelector("#brief-off").onclick=function(){
        agentSay("Tap the row that's wrong and I'll take you back to it. Everything stays editable until you lock.");
      };
      wrap.querySelector("#brief-lock").onclick=function(){
        STATE.locked_at=new Date().toISOString();
        completeBeat("B9");
        wrap.querySelector(".actions").innerHTML='<span style="font-size:12px;color:var(--accent)">\u2713 Locked '+STATE.locked_at.slice(0,10)+' — this is the DNA of every asset from here.</span>';
        userSaid("Lock the brief");
        setBeat(9);
        beat10();
      };
    });
  });
}

/* ═══════════════ B10 · GENERATION + CANDIDATES ═══════════════ */
var CANDIDATES=[], regenUsed=false;
function buildCandidates(round){
  var d=DIRECTIONS[STATE.direction];
  var base=[
    {id:"A",dir:"Airy editorial",type:"Cormorant display · grotesk body",font:"'Cormorant Garamond',serif",fw:"500",tf:"none",ls:".05em",pal:[d.pal[0],d.pal[1],d.pal[3]],mock:"hoarding"},
    {id:"B",dir:"Heritage maritime",type:"Serif smallcaps · generous leading",font:"'Cormorant Garamond',serif",fw:"600",tf:"uppercase",ls:".22em",pal:[d.pal[1],d.pal[2],d.pal[0]],mock:"brochure"},
    {id:"C",dir:"Crisp modern",type:"Light grotesk · tight grid",font:"'Space Grotesk',sans-serif",fw:"300",tf:"uppercase",ls:".3em",pal:[d.pal[3],d.pal[1],d.pal[4]],mock:"hoarding"},
    {id:"D",dir:"Soft resort",type:"Humanist grotesk · warm neutrals",font:"'Space Grotesk',sans-serif",fw:"500",tf:"none",ls:".02em",pal:[d.pal[2],d.pal[4],d.pal[0]],mock:"brochure"}
  ];
  if(round===2) base.forEach(function(c){ c.dir=c.dir+" · reworked"; c.pal=[c.pal[1],c.pal[0],c.pal[2]]; });
  return base;
}
function candLogo(c){
  return '<div style="font-family:'+c.font+';font-weight:'+c.fw+';text-transform:'+c.tf+';letter-spacing:'+c.ls+';font-size:'+(c.tf==="uppercase"?"15px":"22px")+';color:var(--fg)">'+esc(STATE.name)+'</div>';
}
function candMock(c){
  var name=esc(STATE.name);
  if(c.mock==="hoarding")
    return '<div style="position:absolute;inset:0;background:linear-gradient(180deg,#20252b 55%,#15181c)">'
      +'<div style="position:absolute;left:0;right:0;top:26%;height:44%;background:'+c.pal[0]+';display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px">'
      +'<div style="font-family:'+c.font+';font-weight:'+c.fw+';text-transform:'+c.tf+';letter-spacing:'+c.ls+';font-size:17px;color:'+c.pal[1]+'">'+name+'</div>'
      +'<div style="font-size:8px;letter-spacing:.28em;color:'+c.pal[1]+';opacity:.7">SEAFRONT RESIDENCES \u00b7 SLIEMA</div></div>'
      +'<div style="position:absolute;bottom:8px;left:0;right:0;text-align:center;font-size:8px;color:#777">site hoarding \u00b7 the Strand</div></div>';
  return '<div style="position:absolute;inset:0;background:'+c.pal[0]+';display:flex;flex-direction:column;justify-content:space-between;padding:16px">'
    +'<div style="font-size:8px;letter-spacing:.28em;color:'+c.pal[1]+';opacity:.75">TWENTY-FOUR RESIDENCES</div>'
    +'<div style="font-family:'+c.font+';font-weight:'+c.fw+';text-transform:'+c.tf+';letter-spacing:'+c.ls+';font-size:19px;color:'+c.pal[1]+'">'+name+'</div>'
    +'<div style="display:flex;justify-content:space-between;align-items:baseline"><div style="font-size:8px;color:'+c.pal[1]+';opacity:.7">BY FALZON GROUP</div><div style="font-size:8px;color:'+c.pal[1]+';opacity:.5">brochure cover</div></div></div>';
}
function beat10(){
  var d=DIRECTIONS[STATE.direction];
  var ov=el('<div class="overlay" id="gen-ov"><div class="gen-blobs">'
    +'<div class="gblob" style="background:'+d.pal[1]+';top:14%;left:16%"></div>'
    +'<div class="gblob" style="background:'+d.pal[2]+';top:44%;right:14%;animation-delay:.7s"></div>'
    +'<div class="gblob" style="background:'+d.pal[3]+';bottom:8%;left:36%;animation-delay:1.3s"></div></div>'
    +'<div class="gen-status"><div class="shimmer-text" id="gen-line">Reading your brief\u2026</div><div class="gs-sub" id="gen-sub">'+esc(STATE.name)+' \u00b7 '+esc(d.name)+'</div></div></div>');
  document.body.appendChild(ov);
  var lines=["Reading your brief\u2026","Drawing four marks\u2026","Setting type against your tone\u2026","Applying each identity to the world\u2026"];
  lines.forEach(function(l,i){ setTimeout(function(){ var g=document.getElementById("gen-line"); if(g) g.textContent=l; },i*1500); });
  wait(REDUCED?400:6200).then(function(){
    ov.remove();
    CANDIDATES=buildCandidates(1);
    agentSay("Four identities, one brief. They differ in direction, not just colour — that's what makes the choice mean something.",
      "Compare any two side by side, or merge two if you're torn. Your selection sets the BrandKit live.").then(showCandidates);
  });
}
var cmpSel=[];
function showCandidates(extra){
  var list=CANDIDATES.slice(); if(extra) list=list.concat([extra]);
  cmpSel=[];
  var html='<div class="cgrid">'+list.map(function(c,i){
    return '<div class="ccard" data-id="'+c.id+'" style="animation-delay:'+(i*130)+'ms">'
      +'<div class="c-mock">'+candMock(c)+'</div>'
      +'<div class="c-body"><div class="c-dir">Candidate '+c.id+' \u00b7 '+esc(c.dir)+'</div>'
      +'<div class="c-logo">'+candLogo(c)+'</div>'
      +'<div class="c-pal">'+c.pal.map(function(h){return '<i style="background:'+h+'"></i>';}).join("")+'</div>'
      +'<div class="c-type">'+esc(c.type)+'</div>'
      +'<div class="c-acts"><button class="btn-p" style="padding:8px 18px;font-size:12px" data-pick="'+c.id+'">This one \u2192</button>'
      +'<button class="btn-g" style="padding:7px 14px;font-size:11px" data-cmp="'+c.id+'">compare</button></div>'
      +'</div></div>';
  }).join("")+'</div>'
  +'<div class="cmp-bar"><span id="cmp-hint">Tap \u201ccompare\u201d on two candidates to see them side by side.</span>'
  +'<button class="btn-g" id="c-merge" style="display:none;font-size:11px">Merge these two</button></div>'
  +'<div class="actions"><button class="btn-g" id="c-none">I don\u2019t love any of them</button></div>';
  var card=addCard(html,"Brand candidates · round "+(regenUsed?"two":"one"));
  card.querySelectorAll("[data-pick]").forEach(function(b){ b.onclick=function(){ pickCandidate(list.find(function(c){return c.id===b.getAttribute("data-pick");}),card); }; });
  card.querySelectorAll("[data-cmp]").forEach(function(b){
    b.onclick=function(){
      var id=b.getAttribute("data-cmp");
      var idx=cmpSel.indexOf(id);
      if(idx>=0) cmpSel.splice(idx,1); else { cmpSel.push(id); if(cmpSel.length>2) cmpSel.shift(); }
      card.querySelectorAll(".ccard").forEach(function(cc){ cc.classList.toggle("cmp",cmpSel.indexOf(cc.getAttribute("data-id"))>=0); });
      var m=card.querySelector("#c-merge"), h=card.querySelector("#cmp-hint");
      if(cmpSel.length===2){ m.style.display="inline-block"; h.textContent="Comparing "+cmpSel.join(" and ")+" — highlighted side by side."; }
      else { m.style.display="none"; h.textContent="Tap \u201ccompare\u201d on two candidates to see them side by side."; }
    };
  });
  card.querySelector("#c-merge").onclick=function(){
    var a=CANDIDATES.find(function(c){return c.id===cmpSel[0];}), b=CANDIDATES.find(function(c){return c.id===cmpSel[1];});
    var m={id:"E",dir:a.dir.split(" ·")[0]+" \u00d7 "+b.dir.split(" ·")[0]+" — merged",type:a.type+" · "+b.dir.toLowerCase()+" palette",font:a.font,fw:a.fw,tf:a.tf,ls:a.ls,pal:b.pal,mock:a.mock};
    card.remove(); userSaid("Merge "+a.id+" and "+b.id);
    agentSay("Candidate E — "+a.id+"\u2019s mark and type, "+b.id+"\u2019s palette. An explicit fifth option, never a silent blend.").then(function(){ showCandidates(m); });
  };
  card.querySelector("#c-none").onclick=function(){
    card.remove(); userSaid("I don't love any of them");
    if(regenUsed){ escalateDesigner(); return; }
    agentSay("That's useful — tell me two things. Which is closest?").then(function(){
      var c1=addCard('<div class="chips">'+CANDIDATES.map(function(c){return '<button class="chip">Candidate '+c.id+'</button>';}).join("")+'</div>');
      c1.querySelectorAll(".chip").forEach(function(ch){ ch.onclick=function(){
        var closest=ch.textContent; c1.remove(); userSaid(closest);
        agentSay("And what's off about it?").then(function(){
          var c2=addCard('<div class="chips">'+["The logo","The colours","The type","The overall feel"].map(function(x){return '<button class="chip">'+x+'</button>';}).join("")+'</div>');
          c2.querySelectorAll(".chip").forEach(function(ch2){ ch2.onclick=function(){
            c2.remove(); userSaid(ch2.textContent); regenUsed=true;
            agentSay("One rework round with that applied — anchored to "+closest.toLowerCase()+", fixing "+ch2.textContent.toLowerCase()+".").then(function(){
              CANDIDATES=buildCandidates(2); showCandidates();
            });
          };});
        });
      };});
    });
  };
}
function escalateDesigner(){
  agentSay("Then I'm not going to keep generating at you. I'm handing this to our design team — with your full brief and everything you've told me about what's off attached.",
    "You'll get human-made candidates. Your brief, taste picks and art direction all carry over — none of this session is wasted.").then(function(){
    addCard('<div style="display:flex;gap:14px;align-items:center"><div class="r-check" style="width:26px;height:26px;border-radius:50%;background:var(--accent);color:var(--accent-ink);display:flex;align-items:center;justify-content:center">\u2192</div><div><div style="font-size:14px;font-weight:500">Escalated to Bricly design team</div><div style="font-size:12px;color:var(--dim)">Brief + feedback attached \u00b7 you\u2019ll be notified when candidates land</div></div></div>',"Handoff");
  });
}
function pickCandidate(c,card){
  card.remove(); userSaid("This one — Candidate "+c.id);
  var mocks=[["Site hoarding","hoarding"],["Brochure cover","brochure"],["Sales sign","hoarding"],["Digital avatar","brochure"]];
  var ov=el('<div class="overlay" id="act-ov"><div class="act-stage">'
    +'<div class="act-cap" id="act-cap">Applying \u2014 site hoarding</div>'
    +'<div class="act-mock" id="act-mock"></div>'
    +'<div class="agent-line" id="act-line" style="margin:10px 0 0;font-size:20px;opacity:0;transition:opacity .6s"></div>'
    +'<div class="actions" style="justify-content:center;opacity:0;transition:opacity .5s" id="act-done"><button class="btn-p">Enter Studio with your brand \u2192</button></div>'
    +'</div></div>');
  document.body.appendChild(ov);
  var mk=document.getElementById("act-mock");
  mocks.forEach(function(m,i){
    setTimeout(function(){
      document.getElementById("act-cap").textContent="Applying \u2014 "+m[0].toLowerCase();
      mk.style.opacity="0";
      setTimeout(function(){ var cc=JSON.parse(JSON.stringify(c)); cc.mock=m[1]; mk.innerHTML=candMock(cc); mk.style.opacity="1"; },REDUCED?0:350);
    }, i*(REDUCED?150:1400));
  });
  setTimeout(function(){
    var al=document.getElementById("act-line");
    al.textContent=STATE.name+" is live. Everything Studio makes from here is on-brand.";
    al.style.opacity="1";
    document.getElementById("act-done").style.opacity="1";
    document.getElementById("act-cap").textContent="BrandKit \u00b7 Active";
  }, mocks.length*(REDUCED?150:1400)+500);
  ov.querySelector("#act-done .btn-p").onclick=function(){
    ov.remove();
    completeBeat("B10");
    setBeat(10);
    addReceipt(10,"BrandKit","<b style='font-weight:600'>Candidate "+esc(c.id)+" · "+esc(c.dir)+"</b> — Active",function(){
      agentSay("The BrandKit is active — exactly one, always your selection, never auto-promoted. Changing it now means re-running candidate selection.");
    });
    agentSay("Done. One consultation: name, buyers, voice, world, taste, art direction — and a live brand.",
      "Next in Studio: the full render set, your sales website, and the brochure — all generated from this brief.");
  };
}

/* ═══════════════ INIT ═══════════════ */
window.addEventListener("DOMContentLoaded",function(){
  stream=document.getElementById("stream");
  buildSpine();
  setBeat(0);
  wait(500).then(beat1);
});
</script>
</body>
</html>
